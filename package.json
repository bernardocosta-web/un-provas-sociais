{
  "name": "un-provas-sociais",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard de depoimentos e provas sociais do Universo Narrado",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "vitest run testes/rls",
    "test:e2e": "playwright test",
    "test:e2e:capturas": "node -e \"process.env.E2E_CAPTURAS='1';process.env.E2E_MARCADOR='E2E-CAPTURAS';require('node:child_process').execSync('npx playwright test e2e/capturas.spec.js',{stdio:'inherit',env:process.env})\"",
    "test:tudo": "vitest run && playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "pg": "^8.13.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
