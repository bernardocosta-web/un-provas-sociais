# Copie para .env e preencha. O .env nunca vai para o Git.
# O valor de VITE_SUPABASE_ANON_KEY pode ser a "publishable key" nova
# (sb_publishable_...) ou a legacy anon key (eyJ...) — supabase-js v2 aceita
# as duas onde a anon key é esperada. NUNCA a Secret key nem a service_role
# key aqui: essas dão acesso total ao banco e nunca vão para o bundle.
# A anon/publishable key NAO e segredo: ela aparece no bundle publicado, por
# design. Quem protege o dado e a RLS.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
